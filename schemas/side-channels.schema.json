{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/savagedamage/cloud-container-escape-corpus/schemas/side-channels.schema.json",
  "title": "Container Side-Channel Inventory",
  "type": "object",
  "required": ["schema_version", "name", "surfaces"],
  "properties": {
    "schema_version": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "leakage", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^SC-\\d{3}$" },
          "name": { "type": "string" },
          "paths": { "type": "array", "items": { "type": "string" } },
          "syscalls": { "type": "array", "items": { "type": "string" } },
          "leakage": { "type": "string" },
          "risk": { "type": "string" },
          "mitigations": { "type": "array", "items": { "type": "string" } },
          "detection": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
