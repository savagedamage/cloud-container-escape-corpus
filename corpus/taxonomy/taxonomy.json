{
  "schema_version": "1.0",
  "name": "Cloud/Container Escape Taxonomy",
  "description": "Structured taxonomy of container escape techniques. Each entry links to a human-readable playbook, MITRE ATT&CK techniques, and Sigma/Falco detection rules.",
  "techniques": [
    {
      "id": "CE-001",
      "name": "cgroup release_agent abuse",
      "category": "kernel/cgroup",
      "aliases": ["release_agent escape", "notify_on_release escape"],
      "summary": "Write a release_agent path and notify_on_release=1 into a writable cgroup v1 hierarchy; the kernel executes the release_agent (a host path) as root when the cgroup empties.",
      "mitre_attack": ["T1611", "T1068"],
      "risk": {"prevalence": "medium", "impact": "critical", "detectability": "high", "overall": "critical"},
      "prerequisites": ["CAP_SYS_ADMIN", "cgroup v1 hierarchy mounted writable", "write access to cgroup filesystem"],
      "guide": "techniques/CE-001-cgroup-release-agent.md",
      "detection_rule_ids": ["SIGMA-001", "FALCO-001"],
      "references": ["https://blog.trailofbits.com/2019/07/19/understanding-docker-container-escapes/"]
    },
    {
      "id": "CE-002",
      "name": "pidfd_getfd / pidfd_open abuse",
      "category": "kernel/proc",
      "aliases": ["pidfd fd stealing", "CVE-2021-22555"],
      "summary": "Use pidfd_open(2)/pidfd_getfd(2) to duplicate file descriptors from other processes when PTRACE_MODE_ATTACH_REALCREDS permits; with host PID visibility this steals host sockets and files.",
      "mitre_attack": ["T1055", "T1611"],
      "risk": {"prevalence": "low", "impact": "critical", "detectability": "medium", "overall": "high"},
      "prerequisites": ["CAP_SYS_PTRACE or ptrace access to target", "target PID visible (hostPID)", "kernel >= 5.6"],
      "guide": "techniques/CE-002-pidfd-getfd.md",
      "detection_rule_ids": ["SIGMA-002", "FALCO-002"],
      "references": ["https://man7.org/linux/man-pages/man2/pidfd_getfd.2.html"]
    },
    {
      "id": "CE-003",
      "name": "Kubernetes RBAC escalation",
      "category": "orchestration/rbac",
      "aliases": ["rbac-buster", "token theft", "impersonation"],
      "summary": "Abuse over-permissive Roles/ClusterRoles: list secrets to steal service-account tokens, impersonate users, bind new roles, or exec into privileged pods.",
      "mitre_attack": ["T1078", "T1611"],
      "risk": {"prevalence": "high", "impact": "critical", "detectability": "high", "overall": "critical"},
      "prerequisites": ["compromised pod or stolen kubeconfig", "permissive RBAC grants (get/list secrets, create pods, bind, impersonate)"],
      "guide": "techniques/CE-003-k8s-rbac-escalation.md",
      "detection_rule_ids": ["SIGMA-010"],
      "references": ["https://kubernetes.io/docs/reference/access-authn-authz/rbac/"]
    },
    {
      "id": "CE-004",
      "name": "Container runtime socket abuse",
      "category": "runtime/socket",
      "aliases": ["docker.sock mount", "dind escape"],
      "summary": "Access to /var/run/docker.sock, containerd.sock or crio.sock grants full container lifecycle control: spawn privileged containers, mount host filesystems, or deploy miners.",
      "mitre_attack": ["T1611", "T1525"],
      "risk": {"prevalence": "medium", "impact": "critical", "detectability": "medium", "overall": "high"},
      "prerequisites": ["runtime socket mounted into container", "client binary available or gRPC access"],
      "guide": "techniques/CE-004-runtime-socket-abuse.md",
      "detection_rule_ids": ["SIGMA-004", "FALCO-004"],
      "references": ["https://docs.docker.com/engine/security/"]
    },
    {
      "id": "CE-005",
      "name": "runc CVE replay",
      "category": "runtime/runc",
      "aliases": ["CVE-2019-5736", "CVE-2024-21626"],
      "summary": "Exploit runc vulnerabilities: overwrite the runc binary via /proc/self/exe (2019-5736) or leak host file descriptors through WORKDIR traversal (2024-21626).",
      "mitre_attack": ["T1611", "T1190"],
      "risk": {"prevalence": "low", "impact": "critical", "detectability": "low", "overall": "high"},
      "prerequisites": ["vulnerable runc version", "ability to run a crafted container image"],
      "guide": "techniques/CE-005-runc-cve-replay.md",
      "detection_rule_ids": ["SIGMA-005", "FALCO-005"],
      "references": ["https://nvd.nist.gov/vuln/detail/CVE-2019-5736", "https://nvd.nist.gov/vuln/detail/CVE-2024-21626"]
    },
    {
      "id": "CE-006",
      "name": "eBPF probe injection",
      "category": "kernel/ebpf",
      "aliases": ["bpf rootkit", "ebpf keylogger"],
      "summary": "Load malicious eBPF programs to hook syscalls, sniff network traffic, hide processes, or tamper with kernel data structures — no kernel module needed.",
      "mitre_attack": ["T1556.002", "T1055", "T1040"],
      "risk": {"prevalence": "low", "impact": "high", "detectability": "low", "overall": "medium"},
      "prerequisites": ["CAP_BPF + CAP_SYS_ADMIN (or CAP_BPF + CAP_PERFMON for tracing)", "BPF JIT enabled", "kernel >= 5.8"],
      "guide": "techniques/CE-006-ebpf-probe-injection.md",
      "detection_rule_ids": ["SIGMA-006", "FALCO-006"],
      "references": ["https://docs.kernel.org/bpf/"]
    },
    {
      "id": "CE-007",
      "name": "Host path / volume mount escape",
      "category": "orchestration/volumes",
      "aliases": ["hostPath escape", "nsenter via /proc"],
      "summary": "Mount sensitive host paths (/, /proc, /sys, /var/run, .kube) then chroot, nsenter, drop systemd units, or write credentials into the host.",
      "mitre_attack": ["T1611", "T1005"],
      "risk": {"prevalence": "high", "impact": "high", "detectability": "high", "overall": "high"},
      "prerequisites": ["pod spec allows hostPath (PSP/PodSecurity bypass)", "privileged pod or adequate capabilities"],
      "guide": "techniques/CE-007-hostpath-volume-escape.md",
      "detection_rule_ids": ["SIGMA-003", "SIGMA-009", "FALCO-003", "FALCO-008"],
      "references": ["https://kubernetes.io/docs/concepts/storage/volumes/#hostpath"]
    },
    {
      "id": "CE-008",
      "name": "Kernel exploit via syscall exposure",
      "category": "kernel/syscalls",
      "aliases": ["io_uring exploit", "userfaultfd exploit", "nftables exploit"],
      "summary": "Trigger kernel vulnerabilities through syscalls that the container's seccomp profile fails to block: io_uring, userfaultfd, keyctl, nftables, unprivileged userns.",
      "mitre_attack": ["T1068", "T1611"],
      "risk": {"prevalence": "low", "impact": "critical", "detectability": "low", "overall": "high"},
      "prerequisites": ["vulnerable kernel version", "syscall not blocked by seccomp", "exploit primitive"],
      "guide": "techniques/CE-008-kernel-syscall-exploit.md",
      "detection_rule_ids": ["SIGMA-011"],
      "references": ["https://www.cisa.gov/known-exploited-vulnerabilities-catalog"]
    },
    {
      "id": "CE-009",
      "name": "Namespace escape via /proc/self/ns",
      "category": "kernel/namespaces",
      "aliases": ["setns escape", "namespace join"],
      "summary": "Manipulate /proc/*/ns/* symlinks or call setns(2) to join host namespaces when host PID namespace is visible and CAP_SYS_ADMIN is present.",
      "mitre_attack": ["T1611"],
      "risk": {"prevalence": "low", "impact": "high", "detectability": "medium", "overall": "medium"},
      "prerequisites": ["host PID namespace visibility", "CAP_SYS_ADMIN", "setns not blocked by seccomp"],
      "guide": "techniques/CE-009-namespace-escape.md",
      "detection_rule_ids": ["SIGMA-003", "FALCO-003"],
      "references": ["https://man7.org/linux/man-pages/man7/namespaces.7.html"]
    },
    {
      "id": "CE-010",
      "name": "Capability-based escape chains",
      "category": "kernel/capabilities",
      "aliases": ["DAC_OVERRIDE abuse", "SYS_MODULE rootkit", "SYS_ADMIN abuse"],
      "summary": "Chain individual capabilities into full escape: DAC_OVERRIDE reads shadow and keys, SYS_MODULE loads kernel modules, SYS_ADMIN mounts host filesystems, SYS_PTRACE injects into host processes.",
      "mitre_attack": ["T1611", "T1068"],
      "risk": {"prevalence": "medium", "impact": "high", "detectability": "high", "overall": "high"},
      "prerequisites": ["over-privileged capability set", "capability not blocked by seccomp", "relevant host resource reachable"],
      "guide": "techniques/CE-010-capability-chains.md",
      "detection_rule_ids": ["SIGMA-007", "SIGMA-008", "FALCO-007"],
      "references": ["https://man7.org/linux/man-pages/man7/capabilities.7.html"]
    },
    {
      "id": "CE-011",
      "name": "IMDS instance metadata credential theft",
      "category": "cloud/metadata",
      "aliases": ["IMDS credential theft", "169.254.169.254 SSRF", "node role theft"],
      "summary": "Read the instance metadata service (169.254.169.254 / fd00:ec2::254) from a workload to steal the node's cloud role credentials, user-data bootstrap secrets, and network layout — the cloud half of the escape.",
      "mitre_attack": ["T1552.005", "T1078.004", "T1530"],
      "risk": {"prevalence": "high", "impact": "critical", "detectability": "medium", "overall": "critical"},
      "prerequisites": ["egress from the container to the metadata address", "IMDSv1 enabled or IMDSv2 token endpoint reachable", "cloud role attached to the node/instance", "CNI or NetworkPolicy that does not filter link-local traffic"],
      "guide": "techniques/CE-011-imds-instance-metadata-theft.md",
      "detection_rule_ids": ["SIGMA-012", "FALCO-009"],
      "references": ["https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/ec2-instance-metadata.html", "https://attack.mitre.org/techniques/T1552/005/"]
    },
    {
      "id": "CE-012",
      "name": "Workload identity token theft",
      "category": "cloud/identity",
      "aliases": ["IRSA token theft", "projected service account token", "workload identity federation abuse"],
      "summary": "Steal the projected service-account JWT that federates a workload to cloud identity (IRSA, GKE and Azure Workload Identity) and exchange it — from inside or outside the cluster — for cloud credentials for the token's lifetime.",
      "mitre_attack": ["T1528", "T1550.001", "T1078.004"],
      "risk": {"prevalence": "medium", "impact": "critical", "detectability": "low", "overall": "high"},
      "prerequisites": ["read access to the projected token file or its env var pointer", "service account bound to a cloud role (IRSA / workload identity)", "egress to the cloud token/STS endpoint", "cluster OIDC issuer reachable for the out-of-cluster exchange"],
      "guide": "techniques/CE-012-workload-identity-token-theft.md",
      "detection_rule_ids": ["SIGMA-013", "FALCO-010"],
      "references": ["https://docs.aws.amazon.com/eks/latest/userguide/iam-roles-for-service-accounts.html", "https://azure.github.io/azure-workload-identity/docs/", "https://attack.mitre.org/techniques/T1528/"]
    }
  ],
  "detection_rules": {
    "SIGMA-001": {"title": "cgroup release_agent write", "file": "detection/sigma/sigma-001-cgroup-release-agent.yml"},
    "SIGMA-002": {"title": "pidfd_getfd syscall usage", "file": "detection/sigma/sigma-002-pidfd-getfd.yml"},
    "SIGMA-003": {"title": "nsenter/setns namespace join", "file": "detection/sigma/sigma-003-nsenter-setns.yml"},
    "SIGMA-004": {"title": "docker socket container create", "file": "detection/sigma/sigma-004-docker-socket-create.yml"},
    "SIGMA-005": {"title": "runc /proc/self/exe overwrite", "file": "detection/sigma/sigma-005-runc-proc-self-exe.yml"},
    "SIGMA-006": {"title": "eBPF program load", "file": "detection/sigma/sigma-006-bpf-load.yml"},
    "SIGMA-007": {"title": "kernel module load", "file": "detection/sigma/sigma-007-kernel-module-load.yml"},
    "SIGMA-008": {"title": "shadow file read (DAC_OVERRIDE)", "file": "detection/sigma/sigma-008-shadow-read.yml"},
    "SIGMA-009": {"title": "chroot into host root", "file": "detection/sigma/sigma-009-chroot-host.yml"},
    "SIGMA-010": {"title": "privileged pod creation (k8s audit)", "file": "detection/sigma/sigma-010-privileged-pod.yml"},
    "SIGMA-011": {"title": "io_uring registration abuse", "file": "detection/sigma/sigma-011-io-uring.yml"},
    "SIGMA-012": {"title": "cloud instance metadata (IMDS) credential theft", "file": "detection/sigma/sigma-012-imds-credential-theft.yml"},
    "SIGMA-013": {"title": "projected workload identity token access", "file": "detection/sigma/sigma-013-workload-identity-token-theft.yml"},
    "FALCO-001": {"title": "cgroup release_agent write", "file": "detection/falco/falco-001-cgroup-release-agent.yaml"},
    "FALCO-002": {"title": "pidfd_getfd syscall", "file": "detection/falco/falco-002-pidfd-getfd.yaml"},
    "FALCO-003": {"title": "nsenter namespace escape", "file": "detection/falco/falco-003-nsenter.yaml"},
    "FALCO-004": {"title": "runtime socket container create", "file": "detection/falco/falco-004-runtime-socket.yaml"},
    "FALCO-005": {"title": "runc binary overwrite", "file": "detection/falco/falco-005-runc-overwrite.yaml"},
    "FALCO-006": {"title": "eBPF program load", "file": "detection/falco/falco-006-bpf-load.yaml"},
    "FALCO-007": {"title": "kernel module load", "file": "detection/falco/falco-007-kernel-module.yaml"},
    "FALCO-008": {"title": "sensitive host path mount", "file": "detection/falco/falco-008-host-mount.yaml"},
    "FALCO-009": {"title": "cloud instance metadata credential access", "file": "detection/falco/falco-009-imds-access.yaml"},
    "FALCO-010": {"title": "projected workload identity token read", "file": "detection/falco/falco-010-workload-identity-token.yaml"}
  }
}
